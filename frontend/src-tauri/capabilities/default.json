{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
    "core:default",
    "allow-browser-tiles",
    "allow-hub-mode",
    "allow-diagnostics",
    "process:allow-restart",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$APPLOG/*" }]
    }
  ]
}
