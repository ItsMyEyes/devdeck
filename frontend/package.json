    "@xterm/xterm": "^6.0.0",
    "ai": "^7.0.58",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "driver.js": "^1.8.0",
    "immer": "^10.1.1",
    "lucide-react": "^1.22.0",
    "material-icon-theme": "^5.36.1",
    "mermaid": "^11.16.1",
    "monaco-editor": "^0.56.0",
    "motion": "^13.0.0",
    "nanoid": "^5.1.16",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-is": "^19.2.7",
    "react-markdown": "^10.1.0",
    "recharts": "^3.9.1",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.23.0",
    "sonner": "^2.0.7",
    "sql-formatter": "^15.8.2",
    "streamdown": "^2.5.0",
