{
  "name": "devdeck",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "devdeck — one operator, many companies. Multi-project dashboard for coding agents (git worktrees + terminals).",
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,green \"wait-on tcp:${DEVDECK_API_PORT:-8989} && vite --host 0.0.0.0\" \"npm run dev:api\"",
    "dev:web": "vite",
    "dev:api": "cd ../backend && go run ./cmd/server --db devdeck.db --open=false --2fa=false --env .env --secure-cookies=false",
    "build": "vite build",
    "build:api": "cd .. && make build-api",
    "preview": "vite preview",
    "pretypecheck": "vite build --outDir node_modules/.routegen --emptyOutDir --logLevel warn",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "tauri:dev": "cd .. && make sidecar-host && cd frontend && tauri dev",
    "tauri:dev-full": "cd .. && make sidecar-host && cd frontend && DEVDECK_TAURI_DEV_FULL=1 tauri dev --config src-tauri/tauri.dev-full.conf.json --no-dev-server",
    "tauri:build": "tauri build",
    "tauri:build:unsigned": "tauri build --no-sign"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@date-fns/tz": "^1.2.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@icons-pack/react-simple-icons": "^12.0.0",
    "@lottiefiles/dotlottie-react": "^0.19.9",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-virtual": "^3.14.5",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-code-block": "^3.29.2",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-list": "^3.29.2",
    "@tiptap/extension-table": "^3.29.2",
    "@tiptap/extensions": "^3.29.2",
    "@tiptap/markdown": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@tiptap/suggestion": "^3.29.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
