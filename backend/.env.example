# Copy to .env (or pass --env /path/to/file) to enable LLM-generated image
# descriptions in the Tools module's markitdown conversion. See COMMANDS.md
# "Tools module setup" for the full external-dependency setup.

OPENAI_API_KEY=
# Optional — for OpenAI-compatible endpoints other than api.openai.com.
OPENAI_BASE_URL=
MARKITDOWN_LLM_MODEL=gpt-4o-mini

# --- Behind a Cloudflare Tunnel (Zero Trust published route) ---
# cloudflared connects from localhost, so trust loopback as the proxy and
# resolve the real client IP from CF-Connecting-IP (the Cloudflare edge
# overwrites it on every request; clients can't spoof it).
#DEVDECK_TRUSTED_PROXIES=127.0.0.1,::1
#DEVDECK_CLIENT_IP_HEADER=CF-Connecting-IP
# Optional: additionally allowlist client IPs at the app layer (defense in
# depth on top of the Cloudflare Access policy).
#DEVDECK_ONLY_FROM=
