# Compiled binaries
/server
/devdeck-api
*.exe
*.test

# SQLite database (runtime data, not source)
*.db
*.db-shm
*.db-wal
*.db-journal

# Go build/test artifacts
*.out

# Generated production UI copied from frontend/dist before portable builds
/internal/webui/dist/*
!/internal/webui/dist/.placeholder

# Local Python venv for the markitdown Tools module (see COMMANDS.md)
/tools/venv/

# LLM credentials loaded via --env for the Tools module — never commit secrets
.env
.env.*
!.env.example
