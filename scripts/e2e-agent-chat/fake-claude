#!/usr/bin/env python3
"""Fake `claude` CLI for DevDeck E2E verification.

Speaks just enough stream-json (--input-format/--output-format stream-json)
for the claude provider adapter: system/init, the `initialize` control
response (model catalog), text replies as stream_event deltas, a terminal
`result`, and acks for set_permission_mode / set_model / interrupt.

Every spawn appends its argv to $FAKE_CLAUDE_LOG (one JSON line), and every
reply echoes the flags this process was started with, so the browser
transcript itself shows which --effort / --permission-mode / --resume the
session actually got.
"""
import json
import os
import sys
import uuid


def arg_after(flag):
    argv = sys.argv[1:]
    for i, a in enumerate(argv):
        if a == flag and i + 1 < len(argv):
            return argv[i + 1]
    return None


def emit(obj):
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()


# DevDeck probes `--help` before every session to decide whether this CLI
# accepts --forward-subagent-text (an unknown option makes the real CLI exit 1,
# so the flag is never assumed). Answer the probe the way the real binary does,
# or the subagent half of the E2E is testing a flag DevDeck never passes.
if "--help" in sys.argv[1:]:
    print(
        "Usage: claude [options] [command] [prompt]\n"
        "Options:\n"
        "  --print                    Print response and exit\n"
        "  --forward-subagent-text    Forward subagent text and thinking blocks as\n"
        "                             assistant/user messages with parent_tool_use_id set\n"
    )
    sys.exit(0)

log_path = os.environ.get("FAKE_CLAUDE_LOG")
if log_path:
    with open(log_path, "a") as f:
        f.write(json.dumps({"pid": os.getpid(), "argv": sys.argv[1:], "cwd": os.getcwd()}) + "\n")

session_id = arg_after("--resume") or str(uuid.uuid4())
effort = arg_after("--effort") or "default"
mode = arg_after("--permission-mode") or "default"
autocompact = arg_after("--autocompact") or "auto"
resumed = arg_after("--resume") is not None
model = arg_after("--model") or "sonnet"

emit({
    "type": "system", "subtype": "init", "session_id": session_id,
    "model": model, "cwd": os.getcwd(), "tools": [], "mcp_servers": [],
    "permissionMode": mode, "capabilities": ["interrupt_receipt_v1"],
})

turn = 0
for raw in sys.stdin:
    raw = raw.strip()
    if not raw:
        continue
    try:
        msg = json.loads(raw)
    except json.JSONDecodeError:
        continue
    t = msg.get("type")

    if t == "control_request":
        req = msg.get("request") or {}
        sub = req.get("subtype")
        rid = msg.get("request_id")
        if sub == "initialize":
            emit({"type": "control_response", "response": {
                "subtype": "success", "request_id": rid,
                "response": {"models": [
                    {"value": "sonnet", "resolvedModel": "claude-sonnet-5", "displayName": "Sonnet 5"},
                    {"value": "opus", "resolvedModel": "claude-opus-5", "displayName": "Opus 5"},
                ]},
            }})
        elif sub == "set_model":
            model = req.get("model") or model
            emit({"type": "control_response", "response": {"subtype": "success", "request_id": rid, "response": {}}})
        else:
            emit({"type": "control_response", "response": {"subtype": "success", "request_id": rid, "response": {}}})
        continue

    if t == "user":
        turn += 1
        text = ""
        content = ((msg.get("message") or {}).get("content")) or []
        for block in content:
            if isinstance(block, dict) and block.get("type") == "text":
                text += block.get("text", "")

        # ── Subagent turn ──
        #
        # Replays the shape of a real spawn, captured against claude 2.1.246:
        # an `Agent` tool_use on the parent's stream, system/task_started, the
        # subagent's own work forwarded as whole assistant frames carrying
        # parent_tool_use_id (never as stream_event deltas — the real CLI emits
        # none for a child), progress ticks, and a terminal task_notification.
        if "subagent" in text.lower():
            spawn_id = f"toolu_spawn_{uuid.uuid4().hex[:8]}"
            task_id = uuid.uuid4().hex[:16]
            mid = f"msg_{uuid.uuid4().hex[:8]}"
            emit({"type": "stream_event", "session_id": session_id,
                  "event": {"type": "message_start", "message": {"id": mid, "role": "assistant", "content": []}}})
            emit({"type": "stream_event", "session_id": session_id, "parent_tool_use_id": None,
                  "event": {"type": "content_block_start", "index": 0,
                            "content_block": {"type": "tool_use", "id": spawn_id, "name": "Agent", "input": {}}}})
            emit({"type": "stream_event", "session_id": session_id,
                  "event": {"type": "content_block_delta", "index": 0,
                            "delta": {"type": "input_json_delta",
                                      "partial_json": json.dumps({"description": "Count to three",
                                                                  "subagent_type": "general-purpose"})}}})
            emit({"type": "stream_event", "session_id": session_id,
                  "event": {"type": "content_block_stop", "index": 0}})
            emit({"type": "system", "subtype": "task_started", "session_id": session_id,
                  "task_id": task_id, "tool_use_id": spawn_id, "description": "Count to three",
                  "subagent_type": "general-purpose", "is_backgrounded": False, "spawn_depth": 1,
                  "task_type": "local_agent", "prompt": "Count to three and report back."})

            def child(blocks):
                emit({"type": "assistant", "session_id": session_id, "parent_tool_use_id": spawn_id,
                      "subagent_type": "general-purpose", "task_description": "Count to three",
                      "uuid": str(uuid.uuid4()),
                      "message": {"id": f"msg_{uuid.uuid4().hex[:8]}", "role": "assistant",
                                  "model": "claude-opus-4-8", "content": blocks}})

            child([{"type": "text", "text": "SUBAGENT-SPEAKS: counting now."}])
            for n, word in enumerate(("ONE", "TWO", "THREE"), start=1):
                child([{"type": "tool_use", "id": f"toolu_bash_{n}", "name": "Bash",
                        "input": {"command": f"echo {word}", "description": f"Print {word}"}}])
                emit({"type": "system", "subtype": "task_progress", "session_id": session_id,
                      "task_id": task_id, "tool_use_id": spawn_id, "description": f"Running Print {word}",
                      "subagent_type": "general-purpose", "last_tool_name": "Bash",
                      "usage": {"total_tokens": 1000 * n, "tool_uses": n, "duration_ms": 1000 * n}})
            child([{"type": "text", "text": "SUBAGENT-DONE: counted to three."}])
            emit({"type": "system", "subtype": "task_updated", "session_id": session_id,
                  "task_id": task_id, "patch": {"status": "completed"}})
            emit({"type": "system", "subtype": "task_notification", "session_id": session_id,
                  "task_id": task_id, "tool_use_id": spawn_id, "status": "completed",
                  "summary": "SUBAGENT-SUMMARY: printed ONE, TWO and THREE.",
                  "usage": {"total_tokens": 3300, "tool_uses": 3, "duration_ms": 3300}})

            parent_reply = f"fake-claude reply #{turn}: the subagent finished. forwarded={'yes' if '--forward-subagent-text' in sys.argv else 'no'}"
            emit({"type": "stream_event", "session_id": session_id,
                  "event": {"type": "content_block_start", "index": 1, "content_block": {"type": "text", "text": ""}}})
            emit({"type": "stream_event", "session_id": session_id,
                  "event": {"type": "content_block_delta", "index": 1,
                            "delta": {"type": "text_delta", "text": parent_reply}}})
            emit({"type": "stream_event", "session_id": session_id,
                  "event": {"type": "content_block_stop", "index": 1}})
            emit({"type": "result", "subtype": "success", "is_error": False, "duration_ms": 9, "num_turns": turn,
                  "result": parent_reply, "session_id": session_id,
                  "usage": {"input_tokens": 120, "output_tokens": 30, "cache_read_input_tokens": 0,
                            "cache_creation_input_tokens": 0}})
            continue

        reply = (
            f"fake-claude reply #{turn}: effort={effort} mode={mode} autocompact={autocompact} "
            f"model={model} resumed={'yes' if resumed else 'no'} session={session_id[:8]} you said: {text!r}"
        )
        mid = f"msg_{uuid.uuid4().hex[:8]}"
        emit({"type": "stream_event", "session_id": session_id,
              "event": {"type": "message_start", "message": {"id": mid, "role": "assistant", "content": []}}})
        emit({"type": "stream_event", "session_id": session_id,
              "event": {"type": "content_block_start", "index": 0, "content_block": {"type": "text", "text": ""}}})
        # Two deltas so the streaming path is exercised, not just one blob.
        half = len(reply) // 2
        for piece in (reply[:half], reply[half:]):
            emit({"type": "stream_event", "session_id": session_id,
                  "event": {"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": piece}}})
        emit({"type": "stream_event", "session_id": session_id,
              "event": {"type": "content_block_stop", "index": 0}})
        emit({"type": "assistant", "session_id": session_id,
              "message": {"id": mid, "role": "assistant", "content": [{"type": "text", "text": reply}]}})
        emit({"type": "result", "subtype": "success", "is_error": False, "duration_ms": 5, "num_turns": turn,
              "result": reply, "session_id": session_id,
              "usage": {"input_tokens": 120 * turn, "output_tokens": 30, "cache_read_input_tokens": 0,
                        "cache_creation_input_tokens": 0}})
        continue
    # anything else (control_response acks etc.) is ignored
